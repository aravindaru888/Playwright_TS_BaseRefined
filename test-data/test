        COMMIT;

    END LOOP;

    DBMS_OUTPUT.PUT_LINE('Chunk done. Total entries: ' 
        || (v_num_days * v_num_entries_per_day));

EXCEPTION
    WHEN OTHERS THEN
        ROLLBACK;
        DBMS_OUTPUT.PUT_LINE('Error: ' || SQLERRM);
        RAISE;
END;
