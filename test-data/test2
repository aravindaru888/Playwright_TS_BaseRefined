    v_num_entries_per_day   NUMBER := &NUM_ENTRIES_PER_DAY;
    v_years_offset          NUMBER := &YEARS_OFFSET;
    v_counter               NUMBER := &COUNTER_START;
    v_day_counter           NUMBER;
    v_entry_counter         NUMBER;
