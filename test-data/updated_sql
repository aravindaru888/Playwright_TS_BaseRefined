-- =====================================================
-- BULK PAYMENT DATA LOADER  (per-chunk)
-- Change YEARS_OFFSET and COUNTER_START for each chunk.
-- =====================================================
-- Chunk 1: YEARS_OFFSET=6  COUNTER_START=1
-- Chunk 2: YEARS_OFFSET=5  COUNTER_START=1331156
-- Chunk 3: YEARS_OFFSET=4  COUNTER_START=2662311
-- Chunk 4: YEARS_OFFSET=3  COUNTER_START=3993466
-- Chunk 5: YEARS_OFFSET=2  COUNTER_START=5324621
-- Chunk 6: YEARS_OFFSET=1  COUNTER_START=6655776
-- =====================================================
-- KEY FIX vs broken version:
--   SPLIT_DETAILS has ONE row per entry whose SPLIT_REFERENCE_ID = v_split_ref_id.
--   Therefore ALL 18 transactions reference that same v_split_ref_id
--   (satisfies SPLIT_REF_ID_FK). RAIL_ROAD still alternates NEFT/RTGS
--   (it is only a label, not a foreign key).
-- =====================================================
DEFINE NUM_DAYS = 365
DEFINE NUM_ENTRIES_PER_DAY = 3647
DEFINE YEARS_OFFSET = 6
DEFINE COUNTER_START = 1

DECLARE
    v_num_days              NUMBER := &NUM_DAYS;
    v_num_entries_per_day   NUMBER := &NUM_ENTRIES_PER_DAY;
    v_years_offset          NUMBER := &YEARS_OFFSET;
    v_counter               NUMBER := &COUNTER_START;
    v_day_counter           NUMBER;
    v_entry_counter         NUMBER;
    v_ref_id                VARCHAR2(30);
    v_split_ref_id          VARCHAR2(30);
    v_display_id            VARCHAR2(16);
    v_transaction_date      DATE;
    v_base_ts               TIMESTAMP WITH TIME ZONE;
BEGIN
    FOR v_day_counter IN 1..v_num_days LOOP
        FOR v_entry_counter IN 1..v_num_entries_per_day LOOP

            v_transaction_date := TRUNC(SYSDATE) - (v_num_days - v_day_counter);
            v_base_ts := SYSTIMESTAMP - NUMTODSINTERVAL(
                (v_num_days - v_day_counter) + (v_years_offset * 365), 'DAY');

            v_ref_id       := '3Ea7' || LPAD(v_counter, 10, '0')
                              || CHR(65 + MOD(v_counter, 26)) || LPAD(v_counter, 9, '0');
            v_split_ref_id := LPAD(v_counter * 2 - 1, 16, '0');   -- globally unique parent key
            v_display_id   := 'OPT' || LPAD(v_counter, 10, '0');

            -- =====================================================
            -- 1. BULK_PAYMENTS (1 per entry)
            -- =====================================================
            INSERT INTO BULK_PAYMENTS (
                REFERENCE_ID, STATUS, FILE_NAME, NOTES, DEBIT_MODE,
                APPROVAL_ID, DISPLAY_ID, CREATED_AT, UPDATED_AT,
                SOURCE_SYSTEM_ID, SOURCE_REFERENCE_ID, CREATED_BY,
                GROUP_ID, IS_CREDIT_ADVICE, SOURCE_TYPE_ID,
                PURPOSE_CODE, PURPOSE_CODE_DESC,
                MOBILE_NUMBER, ENTITY_UCIC, ENTITY_NAME,
                IS_EXTRACTION_COMPLETE
            ) VALUES (
                v_ref_id,
                CASE MOD(v_counter, 3) WHEN 0 THEN 'PROCESSING' WHEN 1 THEN 'SENT' ELSE 'INITIATED' END,
                'OnscreenPayment_' || TO_CHAR(v_transaction_date, 'DDMMYYYY') || '.xlsx',
                'MDMC', '1', '3Ea7ScSym2u0EYj55tagVX4FdX2',
                v_display_id, v_base_ts, v_base_ts, 1,
                LPAD(10355180105 + v_counter, 10, '0'),
                CASE MOD(v_counter, 5) WHEN 0 THEN 'B K Films' WHEN 1 THEN 'ABC Corporation'
                    WHEN 2 THEN 'XYZ Industries' WHEN 3 THEN 'PQR Services' ELSE 'Global Enterprises' END,
                LPAD(10355180105 + v_counter, 10, '0'),
                'Y', 2, 'Salary Pay', 'Salary',
                '94563010' || LPAD(MOD(v_counter, 100), 2, '0'),
                LPAD(10355518492 + MOD(v_counter, 1000), 10, '0'),
                CASE MOD(v_counter, 5) WHEN 0 THEN 'B K Films' WHEN 1 THEN 'ABC Corporation'
                    WHEN 2 THEN 'XYZ Industries' WHEN 3 THEN 'PQR Services' ELSE 'Global Enterprises' END,
                1
            );

            -- =====================================================
            -- 2. BULK_PAYMENT_ACCOUNTS (96% of entries)
            -- =====================================================
            IF MOD(v_counter, 25) != 0 THEN
                INSERT INTO BULK_PAYMENT_ACCOUNTS (
                    ACCOUNT_NUMBER, AMOUNT, BULK_PAYMENTS_REFERENCE_ID,
                    CREATED_AT, ACCOUNT_NAME, TRANSACTIONS_COUNT,
                    MONTH_WISE_TRANSACTIONS_COUNT
                ) VALUES (
                    '214002000015',
                    ROUND(DBMS_RANDOM.VALUE(10000, 500000), 2),
                    v_ref_id, v_base_ts,
                    CASE MOD(v_counter, 5) WHEN 0 THEN 'B K Films - Mumbai' WHEN 1 THEN 'ABC Corporation - Mumbai'
                        WHEN 2 THEN 'XYZ Industries - Mumbai' WHEN 3 THEN 'PQR Services - Mumbai'
                        ELSE 'Global Enterprises - Mumbai' END,
                    MOD(v_counter, 100) + 1,
                    '{' || TO_CHAR(v_transaction_date, 'MON-YYYY') || ':' || ((&NUM_ENTRIES_PER_DAY * 3) + 1) || '}'
                );
            END IF;

            -- =====================================================
            -- 3. BULK_PAYMENT_FILES  (file1 always + file2 57%)
            -- distinct reference ids -> satisfies UNIQUE on BULK_PAYMENTS_REFERENCE_ID
            -- =====================================================
            INSERT INTO BULK_PAYMENT_FILES (ID, BULK_PAYMENTS_REFERENCE_ID, FILE_CONTENT, FILE_NAME)
            VALUES (v_counter * 1000, v_ref_id,
                    TO_BLOB(UTL_RAW.CAST_TO_RAW('File content for ' || v_ref_id)), 'file1.txt');

            IF MOD(v_counter, 100) < 57 THEN
                INSERT INTO BULK_PAYMENT_FILES (ID, BULK_PAYMENTS_REFERENCE_ID, FILE_CONTENT, FILE_NAME)
                VALUES (v_counter * 1000 + 1, v_split_ref_id,
                        TO_BLOB(UTL_RAW.CAST_TO_RAW('File content for ' || v_split_ref_id)), 'file2.txt');
            END IF;

            -- =====================================================
            -- 4. BULK_PAYMENT_SPLIT_DETAILS (1 per entry)
            -- SPLIT_REFERENCE_ID = v_split_ref_id is THE parent the txns reference.
            -- =====================================================
            INSERT INTO BULK_PAYMENT_SPLIT_DETAILS (
                RAIL_ROAD, TRANSACTION_DATE, SPLIT_REFERENCE_ID,
                BULK_PAYMENTS_REFERENCE_ID, STATUS, CREATED_AT, UPDATED_AT
            ) VALUES (
                CASE MOD(v_counter, 2) WHEN 0 THEN 'NEFT' ELSE 'RTGS' END,
                v_transaction_date,
                v_split_ref_id,
                v_ref_id,
                CASE MOD(v_counter, 2) WHEN 0 THEN 'NOT_PROCESSED' ELSE 'SENT' END,
                v_base_ts + NUMTODSINTERVAL(2, 'SECOND'),
                v_base_ts
            );

            -- =====================================================
            -- 5. BULK_PAYMENT_TRANSACTIONS (18 per entry)
            -- FILE_ROW_INDEX 0..17 (unique per ref); all use v_split_ref_id (FK parent).
            -- =====================================================
            FOR txn IN 0..17 LOOP
                INSERT INTO BULK_PAYMENT_TRANSACTIONS (
                    BENEFICIARY_NAME, BENEFICIARY_ACCOUNT_NUMBER,
                    IFSC, RAIL_ROAD, DEBIT_ACCOUNT_NUMBER,
                    TRANSACTION_DATE, AMOUNT, CURRENCY,
                    BENEFICIARY_EMAIL_ID, REMARKS, STATUS,
                    BULK_PAYMENTS_REFERENCE_ID, FILE_ROW_INDEX,
                    SPLIT_REFERENCE_ID, TRANSACTION_ID,
                    APPROVAL_STATUS, UPLOAD_TXN_DATE
                ) VALUES (
                    CASE MOD(v_counter + txn, 5) WHEN 0 THEN 'John Doe' WHEN 1 THEN 'Jane Smith'
                        WHEN 2 THEN 'Robert Johnson' WHEN 3 THEN 'Emily Williams' ELSE 'Michael Brown' END,
                    CASE MOD(v_counter + txn, 5) WHEN 0 THEN '122334455' WHEN 1 THEN '28015545'
                        WHEN 2 THEN '2801227' WHEN 3 THEN '343' ELSE '9876543210' END,
                    CASE MOD(v_counter + txn, 5) WHEN 0 THEN 'ABHY0065001' WHEN 1 THEN 'HDFC0000280'
                        WHEN 2 THEN 'APMC0000003' WHEN 3 THEN 'SBIN0001234' ELSE 'ICIC0001001' END,
                    CASE MOD(txn, 2) WHEN 0 THEN 'NEFT' ELSE 'RTGS' END,
                    '21480288055',
                    v_transaction_date,
                    CASE MOD(txn, 2)
                        WHEN 0 THEN TO_CHAR(ROUND(DBMS_RANDOM.VALUE(100, 10000), 2))
                        ELSE TO_CHAR(ROUND(DBMS_RANDOM.VALUE(10000, 100000), 2)) END,
                    'INR', NULL, NULL,
                    CASE MOD(v_counter, 3) WHEN 0 THEN 'PROCESSING' WHEN 1 THEN 'SENT' ELSE 'INITIATED' END,
                    v_ref_id,
                    txn,
                    v_split_ref_id,
                    'OPT' || LPAD(v_counter * 1000 + txn + 1, 13, '0'),
                    'APPROVED',
                    v_transaction_date
                );
            END LOOP;

            -- =====================================================
            -- 6. BULK_PAYMENT_TXN_CUSTOM_VALUES (~8% of transactions)
            -- =====================================================
            FOR rec IN (
                SELECT ID FROM BULK_PAYMENT_TRANSACTIONS
                WHERE BULK_PAYMENTS_REFERENCE_ID = v_ref_id
                ORDER BY ID
            ) LOOP
                IF MOD(rec.ID, 100) < 8 THEN
                    INSERT INTO BULK_PAYMENT_TXN_CUSTOM_VALUES (ID, VALUES_CUSTOM)
                    VALUES (rec.ID, TO_CLOB('{"1":"Custom Value ' || rec.ID || '","2":"100RS","3":"","4":"","5":""}'));
                END IF;
            END LOOP;

            -- =====================================================
            -- 7. BULK_PAYMENT_CUSTOM_HEADERS (70% of entries)
            -- =====================================================
            IF MOD(v_counter, 100) < 70 THEN
                INSERT INTO BULK_PAYMENT_CUSTOM_HEADERS (REFERENCE_ID, CUSTOM_HEADERS)
                VALUES (v_ref_id, TO_CLOB('{"1":"Salary","2":"Bonus","3":"Incentive","4":"Allowance","5":"Reimbursement"}'));
            END IF;

            v_counter := v_counter + 1;

        END LOOP;

        COMMIT;   -- commit per day to limit undo
    END LOOP;

    DBMS_OUTPUT.PUT_LINE('Chunk done. Entries this chunk: ' || (v_num_days * v_num_entries_per_day));

EXCEPTION
    WHEN OTHERS THEN
        ROLLBACK;
        DBMS_OUTPUT.PUT_LINE('Error: ' || SQLERRM);
        RAISE;
END;
/